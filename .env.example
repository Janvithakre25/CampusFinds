# CampusFind Environment Configuration

# Flask Application
SECRET_KEY=change-this-to-a-very-secret-random-key-in-production
FLASK_ENV=development
FLASK_DEBUG=1

# Database Configuration (MySQL / AWS RDS)
# For local MySQL:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campusfinds
DB_USER=root
DB_PASSWORD=root

# Storage Configuration ('local' or 's3')
STORAGE_BACKEND=local
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload

# AWS S3 Settings (Used only when STORAGE_BACKEND=s3)
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-s3-bucket-name
# In AWS EC2 / ECS / Lambda, IAM Role credentials are automatically used.
# If testing manually with credentials:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
